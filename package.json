{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch server.ts\"",
    "build": "vite build && esbuild server.ts --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "clean": "node -e \"import('fs').then(fs => { fs.rmSync('dist', {recursive: true, force: true}); fs.rmSync('server.js', {force: true}); })\"",
    "lint": "tsc --noEmit",
    "test": "node scripts/test-diagnostics-ttl.mjs && node scripts/test-lan-transfer.mjs",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "build:android": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pako": "^3.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.5",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pako": "^3.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
