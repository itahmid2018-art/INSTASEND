{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch server.ts\"",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js && node -e \"import('fs').then(fs => fs.cpSync('server', 'dist/server', {recursive: true, force: true}))\"",
    "start": "node dist/server.js",
    "clean": "node -e \"import('fs').then(fs => { fs.rmSync('dist', {recursive: true, force: true}); fs.rmSync('server.js', {force: true}); })\"",
    "lint": "tsc --noEmit",
    "test": "node scripts/test-diagnostics-ttl.mjs && node scripts/test-lan-transfer.mjs && node scripts/test-auto-reconnect.mjs && node scripts/test-secret-code-and-expiry.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.4.0",
    "pako": "^3.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.0.0",
    "recharts": "^2.15.0",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pako": "^3.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.2",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite-plugin-pwa": "^0.21.1"
  }
}
